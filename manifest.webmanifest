{
  "name": "Idea Organizer",
  "short_name": "Ideas",
  "description": "Capture ideas by voice, text, photo or link. Auto titles, tags and reminders.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
